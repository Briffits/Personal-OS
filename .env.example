# Personal OS - Example Environment Configuration
#
# This file is safe to commit.
# Never place real secrets, API keys, tokens or passwords in this file.
#
# Create a local .env file for development when required.
# .env is excluded from Git by .gitignore.


# ------------------------------------------------------------
# Personal OS Backend
# ------------------------------------------------------------

PERSONAL_OS_API_URL=https://example.invalid


# ------------------------------------------------------------
# AI Provider
# ------------------------------------------------------------

AI_PROVIDER=placeholder
AI_API_KEY=YOUR_API_KEY_HERE


# ------------------------------------------------------------
# Gmail / Google OAuth
# ------------------------------------------------------------

GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE

# Do not store OAuth client secrets in the mobile application.
# Server-side secrets must remain on the backend.


# ------------------------------------------------------------
# Future Backend Configuration
# ------------------------------------------------------------

BACKEND_ENVIRONMENT=development


# ------------------------------------------------------------
# Development Flags
# ------------------------------------------------------------

ENABLE_MOCK_DATA=true
ENABLE_DEBUG_LOGGING=true
